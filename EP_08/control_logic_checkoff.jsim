// Run the simulation
.tran 7200ns

// Some useful plots... you can plot additional signals by specifying
// the appropriate .plot commands in your main netlist file.

.plot clk
.plot reset
.plot z
.plot irq
.plot betaop(id[31:26])
.plot b(id[31:26])
.plot d(pcsel[2:0])
.plot ra2sel
.plot bsel
.plot alufn[5:0]
.plot wasel
.plot wdsel[1:0]
.plot werf
.plot moe
.plot mwr
