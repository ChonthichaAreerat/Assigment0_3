// Comment out the below two .include when using the module in larger module (e.g. alu)
.include "stdcell.jsim"
.include "nominal.jsim"

.subckt shift sfn[1:0] A[31:0] B[4:0] Y[31:0]

//** shifting left
Xlsb        gnd      lsb_in      knex  // connecting lsb_in to gnd (=0)

// Level 0: use B[4:3] as select of mux4 with proper shifting inputs
XshL8b  A[23:0] lsb_in#8  shL8b[31:0]  knex
XshL16b A[15:0] lsb_in#16 shL16b[31:0] knex
XshL24b A[7:0]  lsb_in#24 shL24b[31:0] knex

XshL0 B[4]#32 B[3]#32 A[31:0] shL8b[31:0] shL16b[31:0] shL24b[31:0] shL0[31:0] mux4

// Level 1: use B[2:1] as select of mux4 with proper shifting inputs
XshL2b shL0[29:0] lsb_in#2  shL2b[31:0]    knex
XshL4b shL0[27:0] lsb_in#4  shL4b[31:0]    knex
XshL6b shL0[25:0] lsb_in#6  shL6b[31:0]    knex

XshL1 B[2]#32 B[1]#32 shL0[31:0] shL2b[31:0] shL4b[31:0] shL6b[31:0] shL1[31:0] mux4

// Level 2: use B[0] as select of mux2 with proper shifting inputs
XshL1b shL1[30:0] lsb_in       shL1b[31:0] knex

Xyl    B[0]#32    shL1[31:0] shL1b[31:0]    YL[31:0]  mux2
  
//**shfiting right
// use sfn[1] to select proper value of msb_in
Xmsb sfn[1]   gnd  A[31]  msb_in  mux2

// Level 0: use B[4:3] as select of mux4 with proper shifting inputs
XshR8b  msb_in#8  A[31:8]  shR8b[31:0] knex
XshR16b msb_in#16 A[31:16] shR16b[31:0] knex
XshR24b msb_in#24 A[31:24] shR24b[31:0] knex

XshR0 B[4]#32 B[3]#32 A[31:0] shR8b[31:0] shR16b[31:0] shR24b[31:0] shR0[31:0] mux4

// Level 1: use B[2:1] as select of mux4 with proper shifting inputs
XshR2b msb_in#2  shR0[31:2] shR2b[31:0]    knex
XshR4b msb_in#4  shR0[31:4] shR4b[31:0]    knex
XshR6b msb_in#6  shR0[31:6] shR6b[31:0]    knex

XshR1 B[2]#32 B[1]#32 shR0[31:0] shR2b[31:0] shR4b[31:0] shR6b[31:0] shR1[31:0] mux4

// Level 2: use B[0] as select of mux2 with proper shifting inputs
XshR1b msb_in    shR1[31:1]   shR1b[31:0]  knex

Xyr    B[0]#32    shR1[31:0] shR1b[31:0]    YR[31:0]   mux2

// sfn[0] select shifting left or right

Xy     sfn[0]#32  YL[31:0] YR[31:0]    Y[31:0]   mux2

.ends